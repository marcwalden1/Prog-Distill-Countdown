+
+def _mem_probe(tag, dump=False):
+    """Debug only (VERL_MEM_PROBE=1): per-rank CUDA allocated/peak, optionally the
+    largest live CUDA tensors reachable from Python (gc)."""
+    if not _MEM_PROBE:
+        return
+    import gc
+    r = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0
+    g = 1 << 30
+    print(f"[memprobe r{r}] {tag}: alloc {torch.cuda.memory_allocated() / g:.2f} GiB, "
+          f"peak {torch.cuda.max_memory_allocated() / g:.2f} GiB, "
+          f"reserved {torch.cuda.memory_reserved() / g:.2f} GiB", flush=True)
+    torch.cuda.reset_peak_memory_stats()
+    if dump and r == 0:
+        seen, rows = set(), []
+        for o in gc.get_objects():
+            try:
+                if torch.is_tensor(o) and o.is_cuda:
+                    st = o.untyped_storage()
+                    key = st.data_ptr()
+                    if key in seen:
+                        continue
+                    seen.add(key)
+                    rows.append((st.nbytes(), tuple(o.shape), str(o.dtype), o.requires_grad, type(o).__name__))
+            except Exception:
+                pass
+        rows.sort(reverse=True)
+        tot = sum(x[0] for x in rows)
+        print(f"[memprobe r{r}] {tag}: {len(rows)} gc-visible CUDA storages, {tot / g:.2f} GiB total; top 15:", flush=True)
+        for nb, sh, dt, rg, ty in rows[:15]:
+            print(f"    {nb / g:8.3f} GiB  {ty} {sh} {dt} requires_grad={rg}", flush=True)
+
+
+def _mem_probe_referrers(tag):
+    """Debug only (VERL_MEM_PROBE=1): for each live full-vocab logits tensor, print the
+    chain of Python objects referring to it, then what the cycle collector frees."""
+    if not _MEM_PROBE or torch.distributed.get_rank() != 0:
+        return
+    import gc
+    import types
+
+    def desc(o):
+        t = type(o)
+        name = f"{t.__module__}.{t.__qualname__}"
+        if isinstance(o, dict):
+            return f"{name} keys={list(o.keys())[:8]}"
+        if isinstance(o, (list, tuple)):
+            return f"{name} len={len(o)}"
+        if isinstance(o, types.FrameType):
+            return f"frame {o.f_code.co_name} {o.f_code.co_filename}:{o.f_lineno}"
+        if isinstance(o, types.CellType):
+            return "cell"
+        if isinstance(o, types.FunctionType):
+            return f"function {o.__qualname__}"
+        if torch.is_tensor(o):
+            return f"Tensor {tuple(o.shape)}"
+        return name
+
+    vocab_big = [o for o in gc.get_objects()
+                 if torch.is_tensor(o) and o.is_cuda and o.dim() == 3 and o.shape[-1] > 100000]
+    print(f"[memprobe-ref] {tag}: {len(vocab_big)} live full-vocab tensors", flush=True)
+    skip = {id(vocab_big)}
+    for i, t in enumerate(vocab_big):
+        print(f"[memprobe-ref]  tensor {i}: {tuple(t.shape)} {t.dtype}", flush=True)
+        frontier, seen = [(t, 0)], {id(t)}
+        while frontier:
+            o, d = frontier.pop(0)
+            if d >= 5:
+                continue
+            for r in gc.get_referrers(o):
+                if id(r) in seen or id(r) in skip or r is frontier or isinstance(r, types.FrameType) and r.f_code.co_name == "_mem_probe_referrers":
+                    continue
+                seen.add(id(r))
+                print(f"[memprobe-ref]    {'  ' * d}<- {desc(r)}", flush=True)
+                frontier.append((r, d + 1))
+                if len(seen) > 60:
+                    frontier = []
+                    break
+    del vocab_big
+    gc.set_debug(gc.DEBUG_SAVEALL)
+    n = gc.collect()
+    from collections import Counter
+    c = Counter(desc(o).split(" keys=")[0].split(" len=")[0] for o in gc.garbage)
+    print(f"[memprobe-ref] gc.collect found {n} unreachable objects; types: {c.most_common(25)}", flush=True)
+    gc.garbage.clear()
+    gc.set_debug(0)
+
+
+def kd_token_loss(logits, kd_ids, kd_logprobs, kd_mask, labels, chunk=8):
+    """Bucketed forward KL(teacher || student) per position (local patch 8, data.kd).
+
+    Buckets per position: each active slot of kd_ids (teacher top-k, plus the
+    sampled token when outside the top-k; see DistillKDDataset) is its own
+    bucket, and every other vocab token is lumped into one tail bucket.
+        teacher: p_b = exp(kd_logprobs), p_tail = max(0, 1 - sum_b p_b)
+        student: q_b = softmax(logits)[id_b], q_tail = 1 - sum_b q_b
+        KL = sum_b p_b (log p_b - log q_b) + p_tail (log p_tail - log q_tail)
+    The p log p terms carry no gradient but make the value an actual KL (>= 0).
+
+    logits (B, T, V) any float dtype; kd_* (B, T, K); labels (B, T).
+    Returns (kl, ce), each (B, T) fp32; ce = -log q(label) (detached), so it is
+    directly comparable with the NTP arm's loss. Upcasts to fp32 in batch
+    chunks so the transient exp() buffer is chunk-sized.
+    """
+    kls, ces = [], []
+    for s in range(0, logits.shape[0], chunk):
+        lg = logits[s:s + chunk].float()
+        lse = torch.logsumexp(lg, dim=-1, keepdim=True)
+        m = kd_mask[s:s + chunk]
+        s_lp = (torch.gather(lg, -1, kd_ids[s:s + chunk]) - lse).masked_fill(~m, 0.0)
+        # log sum_b q_b; masked slots -> large negative finite (an all-masked row
+        # must not produce -inf, whose logsumexp gradient is NaN)
+        s_named = torch.logsumexp(s_lp.masked_fill(~m, -1e30), dim=-1)
+        # log q_tail = log(1 - exp(s_named)); clamp keeps it finite (>= ~ -13.8)
+        s_tail = torch.log(-torch.expm1(s_named.clamp(max=-1e-6)))
+        t_p = torch.exp(kd_logprobs[s:s + chunk].float()) * m
+        t_tail = (1.0 - t_p.sum(-1)).clamp(min=0.0)
+        kl = (torch.xlogy(t_p, t_p) - t_p * s_lp).sum(-1) + torch.xlogy(t_tail, t_tail) - t_tail * s_tail
+        kls.append(kl)
+        with torch.no_grad():
+            ces.append(lse.squeeze(-1) - torch.gather(lg, -1, labels[s:s + chunk, :, None]).squeeze(-1))
+    return torch.cat(kls), torch.cat(ces)
+
